generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("admin") // admin | employee — default admin para no dejar afuera a los usuarios existentes al agregar la columna
  createdAt    DateTime @default(now())

  createdSales                Sale[]
  createdExpenses              Expense[]
  createdCustomerLedgerEntries CustomerLedgerEntry[]
  createdSupplierLedgerEntries SupplierLedgerEntry[]
  createdPurchaseOrders        PurchaseOrder[]
  createdPurchaseOrderStatusEvents PurchaseOrderStatusEvent[]
}

model Product {
  id          String   @id @default(cuid())
  sku         String?  @unique
  name        String
  description String?
  imageUrl    String? // foto del producto (Vercel Blob), usada en buscadores/listados
  price       Int // precio de venta de la unidad completa (ej: la bolsa entera)
  cost        Int? // costo — interno, referencia para margen
  status      String   @default("active") // active | archived
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])

  // Venta fraccionada (opcional): si fractionUnit está seteado, el producto
  // se puede vender también por fracción (ej: por kg) además de por unidad
  // completa. unitSize = cuántas unidades de fracción tiene 1 unidad
  // completa (ej: 20 kg por bolsa). fractionPrice = precio por 1 unidad de
  // fracción (ej: precio por kg).
  fractionUnit  String?
  unitSize      Float?
  fractionPrice Int?

  // Datos específicos para productos de mascotas/veterinaria (opcionales).
  brand       String?
  animalType  String? // ej: perro, gato
  animalWeight String? // ej: "1-10 kg" — texto libre, no siempre es un rango exacto

  subrubroId String
  subrubro   Subrubro @relation(fields: [subrubroId], references: [id])

  // Fecha de alta: cuándo el producto empezó a estar disponible para la
  // venta (puede ser anterior al día en que se cargó en el sistema).
  // Opcional para no romper productos ya cargados antes de este campo —
  // el formulario de creación siempre la pide de acá en adelante.
  registeredAt DateTime?

  // Última vez que cambió el precio o el costo (alta, edición manual,
  // actualización por lote, o recepción de un pedido con costo nuevo).
  priceUpdatedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  saleItems     SaleItem[]
  purchaseItems PurchaseOrderItem[]
  stocks        ProductStock[] // stock independiente por sucursal — ver modelo Branch

  @@index([status])
  @@index([supplierId])
  @@index([subrubroId])
}

// Una sucursal/local del negocio. El stock de cada producto es
// independiente por sucursal (ver ProductStock); clientes, proveedores y
// tipos de gasto son compartidos entre todas.
model Branch {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  productStocks  ProductStock[]
  sales          Sale[]
  purchaseOrders PurchaseOrder[]
  expenses       Expense[]
}

// Stock de un producto en una sucursal puntual. Todo producto tiene una
// fila acá por cada sucursal existente (invariante mantenida por código,
// no por la base): se crea al dar de alta el producto o la sucursal.
model ProductStock {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id])
  stock     Float   @default(0) // en la unidad de fracción si el producto es fraccionable (ej: kg); si no, en unidades enteras
  minStock  Float? // nivel para avisar reposición; si no se carga, se usa un default en la app

  @@unique([productId, branchId])
  @@index([branchId])
}

// Clasificación de productos en dos niveles — ej: rubro "Alimento
// balanceado" con subrubros "Mordida chica" / "Mordida grande".
model Rubro {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  subrubros Subrubro[]
}

model Subrubro {
  id        String   @id @default(cuid())
  name      String
  rubroId   String
  rubro     Rubro    @relation(fields: [rubroId], references: [id])
  createdAt DateTime @default(now())

  products Product[]

  @@unique([rubroId, name])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  taxId     String? // CUIT / DNI
  email     String?
  phone     String?
  address   String?
  city      String?
  createdAt DateTime @default(now())

  sales   Sale[]
  ledger  CustomerLedgerEntry[]
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  taxId     String?
  email     String?
  phone     String?
  address   String?
  city      String?
  createdAt DateTime @default(now())

  products       Product[]
  purchaseOrders PurchaseOrder[]
  ledger         SupplierLedgerEntry[]
}

model Sale {
  id          String    @id @default(cuid())
  // Null = venta general, sin cliente asignado (no genera cargo en ninguna
  // cuenta corriente).
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  total       Int
  status      String   @default("confirmed") // confirmed | cancelled
  note        String?
  billViaArca Boolean  @default(false)
  createdAt   DateTime @default(now())

  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id])

  items       SaleItem[]
  ledgerEntry CustomerLedgerEntry?
  arcaInvoice ArcaInvoice?

  @@index([customerId])
  @@index([branchId])
}

// Factura electrónica emitida (o intentada) en ARCA (ex AFIP) para una
// venta puntual — el emisor factura como monotributista, siempre Factura C.
model ArcaInvoice {
  id            String    @id @default(cuid())
  saleId        String    @unique
  sale          Sale      @relation(fields: [saleId], references: [id])
  status        String    @default("pending") // pending | issued | error
  voucherType   Int       @default(11) // 11 = Factura C
  pointOfSale   Int?
  invoiceNumber Int?
  cae           String?
  caeExpiration DateTime?
  errorMessage  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Ticket de acceso (WSAA) reutilizado entre invocaciones para no volver a
// autenticarse contra ARCA en cada factura — pisa el error "ya posee un TA
// válido" que tira ARCA si se pide un ticket nuevo estando uno vigente.
model ArcaTicket {
  id             String   @id // ej: "wsfe-homologacion" | "wsfe-produccion"
  data           Json
  expirationDate DateTime
  updatedAt      DateTime @updatedAt
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  saleUnit  String  @default("unit") // "unit" (unidad/bolsa completa) | "fraction" (ej: por kg)
  quantity  Float // cantidad en la unidad elegida (bolsas si "unit", kg si "fraction")
  unitPrice Int // precio por esa unidad
  stockDelta Float // cuánto se descontó del stock (en unidad base) — fijo, para poder reponerlo bien si se cancela

  @@index([saleId])
}

model CustomerLedgerEntry {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  type       String // "charge" (venta) | "payment" (pago del cliente)
  amount     Int // siempre positivo; el signo lo da "type"
  paymentMethod String? // solo en type "payment": cash | transfer | card | other
  note       String?
  saleId     String?  @unique
  sale       Sale?    @relation(fields: [saleId], references: [id])
  createdAt  DateTime @default(now())

  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id])

  @@index([customerId])
}

model PurchaseOrder {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  status     String   @default("pending") // pending | sent | received | cancelled
  orderDate  DateTime @default(now()) // fecha del pedido (editable), distinta de createdAt
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id])

  items        PurchaseOrderItem[]
  ledgerEntry  SupplierLedgerEntry?
  statusEvents PurchaseOrderStatusEvent[]

  @@index([supplierId])
  @@index([status])
  @@index([branchId])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantity         Float // cantidad pedida, siempre en unidades completas (ej: bolsas)
  unitCost         Int
  receivedQuantity Float? // cantidad realmente recibida (puede diferir de lo pedido) — se completa al recibir
  stockDelta       Float? // cuánto sumó al stock al recibirse (receivedQuantity * unitSize del producto en ese momento)

  @@index([purchaseOrderId])
}

model PurchaseOrderStatusEvent {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  status          String
  createdAt       DateTime      @default(now())

  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id])

  @@index([purchaseOrderId])
}

model SupplierLedgerEntry {
  id              String         @id @default(cuid())
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  type            String // "charge" (recepción de pedido) | "payment" (pago al proveedor)
  amount          Int
  paymentMethod   String? // solo en type "payment": cash | transfer | card | other
  note            String?
  purchaseOrderId String?        @unique
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  createdAt       DateTime       @default(now())

  createdByUserId String?
  createdByUser   User?          @relation(fields: [createdByUserId], references: [id])

  @@index([supplierId])
}

// Gastos del negocio (impuestos, luz, gas, alquiler, etc.) — independientes
// de Proveedores/Pedidos, para poder calcular la ganancia neta (margen de
// ventas menos gastos) por separado del margen bruto.
model ExpenseType {
  id               String   @id @default(cuid())
  name             String   @unique
  isRecurring      Boolean  @default(false) // se repite todos los meses (ej: alquiler, luz) — antes era un check por gasto, ahora es propio del tipo
  hasSecondDueDate Boolean  @default(false) // tiene vencimiento con recargo (ej: luz, gas)
  createdAt        DateTime @default(now())

  expenses  Expense[]
}

model Expense {
  id            String      @id @default(cuid())
  expenseTypeId String
  expenseType   ExpenseType @relation(fields: [expenseTypeId], references: [id])
  // Null = gasto compartido, para todas las sucursales (ej: software,
  // impuestos generales) — no se le puede asignar solo a una.
  branchId      String?
  branch        Branch?     @relation(fields: [branchId], references: [id])
  amount        Int
  dueDate       DateTime // fecha de vencimiento del gasto
  secondDueDate DateTime? // vencimiento con recargo — solo si expenseType.hasSecondDueDate
  paidDate      DateTime? // fecha en que se pagó — null significa impago
  paymentMethod String // cash | transfer | card | other
  note          String?
  createdAt     DateTime    @default(now())

  createdByUserId String?
  createdByUser   User?     @relation(fields: [createdByUserId], references: [id])

  @@index([expenseTypeId])
  @@index([dueDate])
  @@index([paidDate])
  @@index([branchId])
}
